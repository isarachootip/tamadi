# คัดลอกไฟล์นี้เป็น .env สำหรับการพัฒนาบนเครื่อง (ห้าม commit ไฟล์ .env ลง Git)
NODE_ENV=development

# ฐานข้อมูล PostgreSQL 16 และ Redis 7 (รันผ่าน infra/docker-compose.dev.yml บนพอร์ต 5433 และ 6379)
DATABASE_URL=postgres://tamadee:tamadee_dev_only@127.0.0.1:5433/tamadee
REDIS_URL=redis://127.0.0.1:6379

# โหมดการทำงานของ Medusa: shared (พัฒนาในเครื่อง), server (API + Admin), worker (งานเบื้องหลัง)
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false

# CORS สำหรับทั้ง 4 โดเมนของ Tamadee และพอร์ตพัฒนาบนเครื่อง
STORE_CORS=https://m.tamadee.online,https://tamdi.tamadee.online,https://webtamdi.tamadee.online,http://localhost:3000,http://localhost:8000,http://localhost:8080
ADMIN_CORS=https://bwebtamdi.tamadee.online,http://localhost:7000,http://localhost:9000
VENDOR_CORS=https://bwebtamdi.tamadee.online,http://localhost:7001,http://localhost:9000
AUTH_CORS=https://m.tamadee.online,https://tamdi.tamadee.online,https://webtamdi.tamadee.online,https://bwebtamdi.tamadee.online,http://localhost:3000,http://localhost:7000,http://localhost:7001,http://localhost:8080,http://localhost:9000

# กุญแจเข้ารหัส JWT และ Cookie (บน Production ต้องสุ่มค่าใหม่ที่คาดเดาไม่ได้)
JWT_SECRET=change-me-jwt-secret-min-32-chars
COOKIE_SECRET=change-me-cookie-secret-min-32-chars

# URL ของ Backend และ Vendor Panel
MERCUR_BACKEND_URL=http://localhost:9000
MERCUR_VENDOR_URL=http://localhost:9000/seller
STOREFRONT_REVALIDATE_URL=http://localhost:3000
STOREFRONT_REVALIDATE_SECRET=change-me-revalidate-secret

# บัญชีทดสอบเริ่มต้นสำหรับสคริปต์ seed (เปลี่ยนรหัสผ่านเมื่อนำไปใช้จริง)
TAMADEE_SEED_ADMIN_EMAIL=admin@tamadee.online
TAMADEE_SEED_ADMIN_PASSWORD=change-me-admin-password
TAMADEE_SEED_SELLER_PASSWORD=change-me-seller-password

# การจัดเก็บไฟล์รูปภาพ:
# - หากเว้นว่าง S3_BUCKET ระบบจะเก็บไฟล์ลงโฟลเดอร์ static ในเครื่องอัตโนมัติ (สำหรับพัฒนา)
# - หากกำหนดค่า S3_BUCKET ระบบจะใช้ Cloudflare R2 (S3-compatible)
FILE_BACKEND_URL=http://localhost:9000/static
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
