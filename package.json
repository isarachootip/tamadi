{
  "name": "tamadee-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Tamadee (ทำมาดี ทำมาขาย) — Multi-vendor Marketplace Monorepo",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "infra:dev:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "infra:dev:down": "docker compose -f infra/docker-compose.dev.yml down",
    "backend:migrate": "pnpm --dir apps/backend --filter @acme/api db:migrate",
    "backend:seed": "pnpm --dir apps/backend --filter @acme/api seed",
    "backend:dev": "pnpm --dir apps/backend dev",
    "backend:build": "pnpm --dir apps/backend build"
  }
}
