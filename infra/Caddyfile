# Caddyfile สำหรับ Tamadee (4 โดเมนหลัก ออกใบรับรอง SSL อัตโนมัติผ่าน Let's Encrypt)
(common_headers) {
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# 1. Backend API, Operator Admin (/dashboard) และ Vendor Panel (/seller)
bwebtamdi.tamadee.online {
	import common_headers
	reverse_proxy backend:9000
}

# 2. Flutter Mobile App (Web Build + Android App Links / iOS Universal Links)
m.tamadee.online {
	import common_headers
	reverse_proxy mobile-web:8080
}

# 3 & 4. Next.js Storefront โค้ดชุดเดียว แยก Layout ด้วย Hostname ใน middleware
# - tamdi.tamadee.online    -> Mobile Web PWA (โหลดไวทันทีจากลิงก์โซเชียล)
# - webtamdi.tamadee.online -> Desktop Web & Google SEO
tamdi.tamadee.online, webtamdi.tamadee.online {
	import common_headers
	reverse_proxy storefront:3000
}
